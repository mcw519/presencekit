# Optional ONNX Runtime CPU settings for vision models.
PRESENCE_ORT_PROVIDERS=cpu
PRESENCE_ORT_THREADS=2
PRESENCE_ORT_ALLOW_SPINNING=0

# Optional cloud API keys. Fill these in .env or in the browser's Settings.
ASSEMBLYAI_API_KEY=
TYPESAFE_API_KEY=

# Optional proxy or test endpoints. Leave commented to use the provider defaults.
# ASSEMBLYAI_WS_URL=
# REID_JEV_URL=
